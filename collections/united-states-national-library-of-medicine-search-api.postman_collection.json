          "request": {
            "name": "Search Entrez Database",
            "description": {
              "content": "Search any Entrez database and retrieve document identifiers (UIDs) matching a query. Supports full Entrez query syntax including Boolean operators, field tags, and date ranges.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "esearch.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "(Required) Target Entrez database (e.g. pubmed, nuccore, protein, gene, snp, mesh, pmc)"
                },
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "(Required) Entrez text query with optional field tags and Boolean operators"
                },
                {
                  "disabled": false,
                  "key": "api_key",
