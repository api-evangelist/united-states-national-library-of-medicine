{
  "opencollection": "1.0.0",
  "info": {
    "name": "NCBI URL BLAST Fetch API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Fetch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://blast.ncbi.nlm.nih.gov/blast/efetch.fcgi",
            "params": [
              {
                "name": "db",
                "value": "pubmed",
                "type": "query",
                "description": "Target Entrez database"
              },
              {
                "name": "id",
                "value": "33515491,33515492",
                "type": "query",
                "description": "Comma-separated list of UIDs to retrieve"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "NCBI API key"
              },
              {
                "name": "rettype",
                "value": "abstract",
                "type": "query",
                "description": "Record type to return (e.g. abstract, medline, fasta, gb, docsum)"
              },
              {
                "name": "retmode",
                "value": "",
                "type": "query",
                "description": "Output format"
              },
              {
                "name": "retmax",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to retrieve"
              },
              {
                "name": "retstart",
                "value": "",
                "type": "query",
                "description": "Starting index in the UID list"
              }
            ]
          },
          "docs": "Retrieve full records from an Entrez database in various formats. Commonly used to retrieve PubMed article abstracts, nucleotide sequences in FASTA format, or gene records."
        },
        {
          "info": {
            "name": "Get Document Summaries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://blast.ncbi.nlm.nih.gov/blast/esummary.fcgi",
            "params": [
              {
                "name": "db",
                "value": "pubmed",
                "type": "query",
                "description": "Target Entrez database"
              },
              {
                "name": "id",
                "value": "33515491,33515492",
                "type": "query",
                "description": "Comma-separated list of UIDs"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "NCBI API key"
              },
              {
                "name": "retmode",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve document summaries (DocSums) for records from any Entrez database. Returns a concise summary of record attributes including title, authors, journal, and publication date for PubMed records."
        }
      ]
    }
  ],
  "bundled": true
}