          "name": "Get Linked Records",
          "request": {
            "name": "Get Linked Records",
            "description": {
              "content": "Find records related to a set of input UIDs in any Entrez database. Supports finding related articles, linked sequences, gene-to-protein links, and other cross-database connections.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "elink.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dbfrom",
                  "value": "<string>",
                  "description": "(Required) Source database"
                },
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "Target database (leave empty for related records in same db)"
                },
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) Comma-separated source UIDs"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "cmd",
                  "value": "neighbor",
                  "description": "Link command (neighbor, prlinks, llinks, acheck, ncheck, lcheck)"
                },
                {
                  "disabled": false,
                  "key": "linkname",
                  "value": "<string>",
                  "description": "Named link to follow (e.g. pubmed_pubmed_citedin)"
                },
                {
                  "disabled": false,
                  "key": "retmode",
                  "value": "json"
                }
              ],
              "variable": []
            },
