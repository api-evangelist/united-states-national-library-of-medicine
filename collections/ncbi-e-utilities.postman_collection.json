      "item": [
        {
          "id": "8fc7d79a-f402-4152-8585-d46ea1220e50",
          "name": "Search Entrez Database",
          "request": {
            "name": "Search Entrez Database",
            "description": {
              "content": "Search any Entrez database and retrieve document identifiers (UIDs) matching a query. Supports full Entrez query syntax including Boolean operators, field tags, and date ranges.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "esearch.fcgi"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "db",
                  "value": "<string>",
                  "description": "(Required) Target Entrez database (e.g. pubmed, nuccore, protein, gene, snp, mesh, pmc)"
                },
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "(Required) Entrez text query with optional field tags and Boolean operators"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "NCBI API key for increased rate limits"
                },
                {
                  "disabled": false,
                  "key": "retmax",
                  "value": "20",
                  "description": "Maximum number of UIDs to return (default 20, max 10000)"
                },
                {
                  "disabled": false,
                  "key": "retstart",
                  "value": "0",
                  "description": "Index of first UID in results (for pagination)"
                },
                {
                  "disabled": false,
                  "key": "retmode",
                  "value": "json",
                  "description": "Output format"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort order for results"
                },
                {
                  "disabled": false,
                  "key": "datetype",
                  "value": "<string>",
                  "description": "Date type for date range filtering"
                },
                {
                  "disabled": false,
                  "key": "mindate",
                  "value": "<string>",
                  "description": "Minimum date for range filter (YYYY/MM/DD)"
                },
                {
                  "disabled": false,
                  "key": "maxdate",
                  "value": "<string>",
                  "description": "Maximum date for range filter (YYYY/MM/DD)"
                },
                {
                  "disabled": false,
                  "key": "usehistory",
                  "value": "<string>",
                  "description": "Store results on NCBI server (y/n)"
                }
